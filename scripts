#!/bin/bash
echo "🔒 ProofGate Local Verification"

sha256sum capsule_manifest.json > digest.sha256
sha512sum capsule_manifest.json > digest.sha512

diff digest.sha256 expected.sha256 || { echo "❌ SHA-256 mismatch"; exit 1; }
diff digest.sha512 expected.sha512 || { echo "❌ SHA-512 mismatch"; exit 1; }

echo "✅ Capsule manifest verified against expected digests"
